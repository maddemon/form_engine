{
  "name": "@form-engine/adapter-antd-mobile",
  "version": "0.1.0",
  "description": "Form Engine - Antd Mobile 组件适配器",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit"
  },
  "keywords": ["form", "engine", "antd-mobile", "adapter"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@form-engine/core": "workspace:*",
    "antd-mobile": "^5.42.3"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "antd-mobile": ">=5.0.0"
  },
  "devDependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "~6.0.2",
    "tsup": "^8.0.0",
    "rimraf": "^5.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  }
}
