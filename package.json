{
  "name": "form-engine-monorepo",
  "version": "0.1.0",
  "description": "A schema-driven form engine with adapter support",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @form-engine/* dev",
    "dev:example": "pnpm --filter example dev",
    "build": "pnpm --filter @form-engine/core --filter @form-engine/adapter-antd --filter @form-engine/adapter-antd-mobile build",
    "clean": "pnpm -r clean",
    "test": "pnpm --filter @form-engine/* test",
    "publish:core": "pnpm --filter @form-engine/core publish",
    "publish:adapter-antd": "pnpm --filter @form-engine/adapter-antd publish",
    "publish:adapter-antd-mobile": "pnpm --filter @form-engine/adapter-antd-mobile publish",
    "publish:all": "pnpm --filter @form-engine/core --filter @form-engine/adapter-antd --filter @form-engine/adapter-antd-mobile publish"
  },
  "devDependencies": {
    "pnpm": "^8.0.0"
  },
  "engines": {
    "node": ">=16",
    "pnpm": ">=8"
  }
}
