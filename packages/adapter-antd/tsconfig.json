{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "paths": {
      "@form-engine/core": ["../core/src"],
      "@form-engine/core/*": ["../core/src/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "../core/tsconfig.json" }],
  "exclude": ["node_modules", "dist"]
}
