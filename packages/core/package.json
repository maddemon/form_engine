{
  "name": "@form-engine/core",
  "version": "0.1.0",
  "description": "Form Engine 核心包 - 类型定义 + 默认 HTML 组件 + 设计器",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "form",
    "engine",
    "schema",
    "renderer",
    "designer"
  ],
  "author": "",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./designer": {
        "import": "./dist/designer/index.mjs",
        "require": "./dist/designer/index.js",
        "types": "./dist/designer/index.d.ts"
      },
      "./styles": {
        "import": "./dist/styles/index.mjs",
        "require": "./dist/styles/index.js",
        "types": "./dist/styles/index.d.ts"
      },
      "./locale": {
        "import": "./dist/locale/index.mjs",
        "require": "./dist/locale/index.js",
        "types": "./dist/locale/index.d.ts"
      },
      "./utils/date": {
        "import": "./dist/utils/date.mjs",
        "require": "./dist/utils/date.js",
        "types": "./dist/utils/date.d.ts"
      }
    }
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^3.2.6"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./designer": {
      "import": "./src/designer/index.ts",
      "types": "./src/designer/index.ts"
    },
    "./styles": {
      "import": "./src/styles/index.ts",
      "types": "./src/styles/index.ts"
    },
    "./locale": {
      "import": "./src/locale/index.ts",
      "types": "./src/locale/index.ts"
    },
    "./utils/date": {
      "import": "./src/utils/date.ts",
      "types": "./src/utils/date.ts"
    }
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "dependencies": {
    "@babel/standalone": "^7.26.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2"
  }
}
